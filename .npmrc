# @blocknote/shadcn declares a peer dependency on tailwindcss v4, but this
# project is on tailwind v3 (the shadcn primitives in src/components/ui and
# tailwind.config.ts are v3-shaped). The v3 setup works fine at runtime, so
# the peer range is relaxed rather than forcing a Tailwind 4 migration.
# Without this, `npm install`/`npm ci` fails with ERESOLVE.
legacy-peer-deps=true
