# The only variable the frontend reads. Everything else (service-role key, JWT
# signing secrets, storage credentials) lives server-side in the gateway and
# must never reach the browser bundle - see DEVDOC.md.
#
# Base URL of the ecosystem gateway; the app calls {this}/apps/workos.
#
# Setting this matters: when it is unset the app falls back to the hosted
# gateway at https://api.dileepadari.dev, so a local build with no .env talks
# to production rather than failing. This file used to name VITE_SUPABASE_URL,
# which nothing reads any more - following it set a variable with no effect and
# left you pointed at the hosted gateway without saying so.
VITE_GATEWAY_URL=http://localhost:54321
